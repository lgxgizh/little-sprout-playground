# Copy this file to `.env` in the project root (never commit `.env`).
# Get a key from https://console.x.ai

XAI_API_KEY=

# Optional. Only needed if you pick OpenAI models in parent settings.
OPENAI_API_KEY=

# Optional. Gemini / Imagen via Google's OpenAI-compatible endpoint.
GEMINI_API_KEY=

# Optional OpenAI-compatible gateway (OpenRouter, SiliconFlow, DeepSeek, Ollama, ...).
# Used when you pick FLUX / Qwen / DeepSeek or a custom model ID.
CUSTOM_API_BASE=
CUSTOM_API_KEY=

# Frontend talks only to this local adapter. Keys stay on the server.
# SuperGrok / grok.com membership does not fill XAI_API_KEY.
VITE_API_BASE_URL=http://127.0.0.1:8787
ADAPTER_PORT=8787
